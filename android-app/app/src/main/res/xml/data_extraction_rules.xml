<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- relay_settings holds the EncryptedSharedPreferences token; its key lives in this
         device's Keystore and won't transfer with a backup, so excluding it avoids a
         decrypt failure after a restore/transfer to a different device. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="relay_settings.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="relay_settings.xml"/>
    </device-transfer>
</data-extraction-rules>