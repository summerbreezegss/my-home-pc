<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- relay_settings holds the EncryptedSharedPreferences token; its key lives in this
         device's Keystore and won't transfer with a backup, so excluding it avoids a
         decrypt failure after a restore to a different device. -->
    <exclude domain="sharedpref" path="relay_settings.xml"/>
</full-backup-content>