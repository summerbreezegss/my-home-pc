# Required: long random token the Android app must send as "Authorization: Bearer <token>"
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_API_TOKEN=changeme-generate-a-long-random-token

# Required for Shutdown/Restart only - must exactly match AGENT_SHARED_SECRET in
# my-home-pc-agent's appsettings.json on the target PC. Leave as a placeholder if you're
# not using my-home-pc-agent (Wake/Status work fine without it).
AGENT_SHARED_SECRET=changeme
