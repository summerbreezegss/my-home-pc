# Required: long random token the MyHomePC app must send as "Authorization: Bearer <token>"
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_API_TOKEN=changeme-generate-a-long-random-token

# Required for Shutdown/Restart only - must exactly match AGENT_SHARED_SECRET in
# my-home-pc-agent's appsettings.json on the target PC. Leave as a placeholder if you're
# not using my-home-pc-agent (Wake/Status work fine without it).
AGENT_SHARED_SECRET=changeme

# Optional: set to "true" to expose FastAPI's interactive docs (/docs, /redoc, /openapi.json)
# as a manual test console. Off by default - they advertise the full API surface,
# unauthenticated, to anyone who can reach the port.
RELAY_ENABLE_DOCS=false

# Optional: auth-failure throttling. After this many consecutive bad/missing tokens from
# one source IP, that IP gets HTTP 429 (even with a correct token) until the lockout
# window passes. Every rejection is logged with the source IP for an audit trail.
# RELAY_AUTH_MAX_FAILURES=5
# RELAY_AUTH_LOCKOUT_SECONDS=300
