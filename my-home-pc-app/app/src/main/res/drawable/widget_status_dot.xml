<?xml version="1.0" encoding="utf-8"?>
<!-- Status dot beside the device name. Drawn white; the provider recolours it per status
     via setColorFilter (green online, amber waking, grey offline/unknown). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@android:color/white" />
</shape>
