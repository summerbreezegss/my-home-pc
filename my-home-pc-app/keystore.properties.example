# Release signing configuration — copy to keystore.properties (gitignored) and fill in.
# The keystore file itself must live OUTSIDE the repo. Losing it (or the passwords)
# permanently breaks the upgrade path for every installed copy of the app — keep the
# keystore file and these values backed up in a password manager.
storeFile=C\:\\path\\to\\my-home-pc-release.jks
storePassword=CHANGE_ME
keyAlias=myhomepc
keyPassword=CHANGE_ME
